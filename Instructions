export function calculatePrice({
  sqm,
  basePrice,
  colorExtraCost,
  extrasTotal,
  shippingPerPackage,
  sqmPerPackage
}) {
  const packagesNeeded = Math.ceil(sqm / sqmPerPackage);
  const pricePerSqm = basePrice + colorExtraCost + extrasTotal;
  const productTotal = sqm * pricePerSqm;
  const shippingTotal = packagesNeeded * shippingPerPackage;
  const grandTotal = productTotal + shippingTotal;

  return {
    sqm,
    pricePerSqm,
    productTotal,
    packagesNeeded,
    shippingTotal,
    grandTotal,
    breakdown: {
      base: basePrice,
      color: colorExtraCost,
      extras: extrasTotal
    }
  };
}
